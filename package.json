{
  "name": "gridhive",
  "version": "0.0.4",
  "description": "Free, open-source board for running many Claude Code agents in parallel, in your browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/customerimpact/gridhive.git"
  },
  "homepage": "https://github.com/customerimpact/gridhive#readme",
  "bugs": {
    "url": "https://github.com/customerimpact/gridhive/issues"
  },
  "type": "module",
  "bin": {
    "gridhive": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/desktop"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/cli.ts --dev",
    "dev:web": "vite",
    "build": "vite build && tsup",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop:icons": "node scripts/build-icons.mjs",
    "desktop:compile": "npm run desktop:icons && vite build && tsup --config tsup.desktop.config.ts",
    "desktop:dev": "npm run desktop:compile && electron dist/desktop/main.js",
    "desktop:build": "npm run desktop:compile && electron-builder --win --dir --publish never",
    "desktop:dist": "npm run desktop:compile && electron-builder --win --publish never",
    "desktop:dist:mac": "npm run desktop:compile && electron-builder --mac --publish never",
    "test:desktop": "playwright test -c playwright.desktop.config.ts",
    "site:shots": "npm run build && node scripts/site-shots.mjs",
    "site:stamp": "node scripts/site-stamp.mjs",
    "relay:keys": "node scripts/relay-keys.mjs",
    "build:viewer": "vite build --config vite.viewer.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "node-pty": "^1.1.0",
    "open": "^11.0.4",
    "qrcode": "1.5.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "concurrently": "^10.0.6",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.59.0",
    "png-to-ico": "3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  }
}
